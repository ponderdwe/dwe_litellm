# Copy to .env, then start:
#   docker-compose up -d          (local dev — includes local PostgreSQL)
#   docker-compose -f docker-compose-prod.yml up -d  (production)

# LiteLLM master API key — used to authenticate all proxy requests
LITELLM_MASTER_KEY=sk-your-master-key-here

# ── AWS Bedrock credentials ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# ── Database (existing PostgreSQL cluster) ────────────────────────────────────
# DB_HOST=myserver.postgres.database.azure.com
# DB_PASS=mypassword
# DB_USER=litellm       # optional, defaults to 'litellm'
# Pulumi creates the 'litellm' database and injects DATABASE_URL automatically.
# For local dev, DATABASE_URL is set by docker-compose.override.yml

# ── Production infrastructure (not needed locally) ────────────────────────────
# These are injected from AWS Secrets Manager in the EC2 user-data script.
# VPC_ID=
# ALB_SUBNET_IDS=["subnet-aaa","subnet-bbb"]
# KEY_NAME=
# ROUTE53_ZONE_ID=
# DNS_NAME=litellm.myorg.com
# ACM_CERTIFICATE_ARN=
# git_deploy_token=
